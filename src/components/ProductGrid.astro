---
import ProductCard from './ProductCard.astro';
import type { Oferta } from '../data/ofertas';
import { ofertas as ofertasLocales } from '../data/ofertas';

interface Props {
  categoria?: string;
  limite?: number;
  ofertasExternas?: Oferta[];
}

const { categoria, limite, ofertasExternas } = Astro.props;

const ofertas = ofertasExternas || ofertasLocales;

const ofertasFiltradas = categoria && categoria !== 'todas' 
  ? ofertas.filter(o => o.categoria === categoria)
  : ofertas;

const ofertasMostradas = limite ? ofertasFiltradas.slice(0, limite) : ofertasFiltradas;

const ofertaDestacada = ofertasMostradas[0];
const restoOfertas = ofertasMostradas.slice(1);
---

<section id="ofertas" class="py-12 lg:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl lg:text-3xl font-black text-white">
          {categoria && categoria !== 'todas' 
            ? `Ofertas en ${categoria.charAt(0).toUpperCase() + categoria.slice(1)}`
            : 'Ofertas destacadas'
          }
        </h2>
        <p class="text-gray-400 text-sm mt-1">{ofertasMostradas.length} productos con descuento</p>
      </div>
      <div class="hidden sm:flex items-center gap-2 text-sm text-gray-400">
        <span>Ordenar por:</span>
        <select class="bg-white/5 border border-white/10 rounded-lg px-3 py-1.5 text-white text-sm focus:outline-none focus:border-ml-yellow/50">
          <option value="descuento">Mayor descuento</option>
          <option value="precio">Menor precio</option>
          <option value="popular">Más popular</option>
        </select>
      </div>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {ofertasMostradas.map((oferta, index) => (
        <ProductCard 
          oferta={oferta} 
          destacada={index === 0 && !categoria}
        />
      ))}
    </div>

    <!-- Load More -->
    {ofertasFiltradas.length > (limite || 999) && (
      <div class="mt-12 text-center">
        <button class="inline-flex items-center gap-2 px-8 py-3 bg-white/5 border border-white/10 rounded-xl text-white font-medium hover:bg-white/10 transition-all">
          Cargar más ofertas
        </button>
      </div>
    )}
  </div>
</section>