---
import { Truck, Star, ExternalLink, TrendingDown, BadgeCheck } from '@lucide/astro';
import type { Oferta } from '../data/ofertas';
import { formatearPrecio } from '../data/ofertas';

interface Props {
  oferta: Oferta;
  destacada?: boolean;
}

const { oferta, destacada = false } = Astro.props;

const ahorro = oferta.precioOriginal - oferta.precioOferta;
---

<article class:list={[
  "group relative rounded-2xl overflow-hidden card-hover",
  destacada ? "bg-gradient-to-b from-ml-yellow/20 to-transparent border-2 border-ml-yellow/30" : "bg-white/5 border border-white/10"
]}>
  <!-- Etiqueta destacada -->
  {oferta.etiqueta && (
    <div class="absolute top-3 left-3 z-10">
      <span class:list={[
        "inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold",
        oferta.etiqueta === 'OFERTA RELÁMPAGO' ? "bg-red-500 text-white animate-pulse" :
        oferta.etiqueta === 'MÁS VENDIDO' ? "bg-ml-yellow text-black" :
        "bg-blue-500 text-white"
      ]}>
        {oferta.etiqueta === 'OFERTA RELÁMPAGO' && <TrendingDown class="w-3 h-3" />}
        {oferta.etiqueta}
      </span>
    </div>
  )}

  <!-- Badge de descuento -->
  <div class="absolute top-3 right-3 z-10">
    <div class="w-14 h-14 rounded-full bg-gradient-to-br from-red-500 to-red-600 flex flex-col items-center justify-center text-white shadow-lg shadow-red-500/30">
      <span class="text-xs font-bold leading-none">-{oferta.descuento}%</span>
      <span class="text-[8px] opacity-80">OFF</span>
    </div>
  </div>

  <!-- Imagen -->
  <a href={`/oferta/${oferta.id}`} class="block aspect-square bg-gradient-to-b from-white/5 to-transparent p-6 flex items-center justify-center">
    <img 
      src={oferta.imagen} 
      alt={oferta.titulo}
      class="max-h-full max-w-full object-contain group-hover:scale-110 transition-transform duration-500"
      loading="lazy"
      onerror="this.src='https://via.placeholder.com/300x300/1a1a2e/FFE600?text=OfertaML'"
    />
  </a>

  <!-- Contenido -->
  <div class="p-5">
    <!-- Categoría -->
    <span class="text-xs font-medium text-ml-yellow uppercase tracking-wider">{oferta.categoria}</span>

    <!-- Título -->
    <a href={`/oferta/${oferta.id}`}>
      <h3 class="mt-1 text-sm font-semibold text-white line-clamp-2 group-hover:text-ml-yellow transition-colors leading-snug">
        {oferta.titulo}
      </h3>
    </a>

    <!-- Rating -->
    <div class="flex items-center gap-2 mt-2">
      <div class="flex items-center gap-0.5">
        {Array.from({ length: 5 }).map((_, i) => (
          <Star 
            class:list={["w-3.5 h-3.5", i < Math.floor(oferta.rating) ? "text-ml-yellow fill-ml-yellow" : "text-gray-600"]}
          />
        ))}
      </div>
      <span class="text-xs text-gray-400">{oferta.rating} ({oferta.reviews.toLocaleString()})</span>
    </div>

    <!-- Precios -->
    <div class="mt-3 space-y-1">
      <div class="flex items-center gap-2">
        <span class="text-xs text-gray-400 line-through">{formatearPrecio(oferta.precioOriginal)}</span>
        <span class="text-xs text-green-400 font-medium">Ahorrás {formatearPrecio(ahorro)}</span>
      </div>
      <div class="text-2xl font-black text-white">{formatearPrecio(oferta.precioOferta)}</div>
    </div>

    <!-- Info extra -->
    <div class="mt-3 space-y-1.5">
      {oferta.envioGratis && (
        <div class="flex items-center gap-1.5 text-xs text-green-400">
          <Truck class="w-3.5 h-3.5" />
          <span class="font-medium">Envío gratis</span>
          <BadgeCheck class="w-3.5 h-3.5" />
        </div>
      )}
      <div class="text-xs text-gray-400">{oferta.cuotas}</div>
    </div>

    <!-- CTA -->
    <a 
      href={oferta.linkAfiliado}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 flex items-center justify-center gap-2 w-full py-3 bg-ml-yellow hover:bg-yellow-300 text-black font-bold rounded-xl transition-all transform hover:scale-[1.02] active:scale-[0.98]"
    >
      <ExternalLink class="w-4 h-4" />
      Ver oferta en ML
    </a>
  </div>
</article>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>