---
import { ArrowRight, Flame, Clock, Percent } from '@lucide/astro';
---

<section class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28">
  <!-- Background effects -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-ml-yellow/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-orange-500/10 rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-ml-yellow/5 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-ml-yellow/10 border border-ml-yellow/20 text-ml-yellow text-sm font-medium mb-8 animate-pulse-slow">
      <Flame class="w-4 h-4" />
      <span>¡Nuevas ofertas cada 6 horas!</span>
    </div>

    <!-- Title -->
    <h1 class="text-4xl sm:text-5xl lg:text-7xl font-black tracking-tight mb-6 leading-tight">
      Las mejores <span class="gradient-text">ofertas</span><br />
      de <span class="relative inline-block">
        <span class="relative z-10">Mercado Libre</span>
        <svg class="absolute -bottom-2 left-0 w-full" viewBox="0 0 300 12" fill="none">
          <path d="M2 10C50 2 100 2 150 6C200 10 250 6 298 2" stroke="#FFE600" stroke-width="4" stroke-linecap="round"/>
        </svg>
      </span>
    </h1>

    <p class="text-lg sm:text-xl text-gray-400 max-w-2xl mx-auto mb-10">
      Encontramos los descuentos más zarpados para que ahorres sin mover un dedo. 
      Tecnología, hogar, moda y más con hasta <span class="text-ml-yellow font-bold">50% OFF</span>.
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a 
        href="#ofertas" 
        class="group inline-flex items-center gap-2 px-8 py-4 bg-ml-yellow text-black font-bold rounded-xl hover:bg-yellow-300 transition-all transform hover:scale-105 shadow-lg shadow-ml-yellow/25"
      >
        Ver ofertas ahora
        <ArrowRight class="w-5 h-5 group-hover:translate-x-1 transition-transform" />
      </a>
      <div class="flex items-center gap-2 text-gray-400 text-sm">
        <Clock class="w-4 h-4" />
        <span>Actualizado hace 15 minutos</span>
      </div>
    </div>

    <!-- Stats Bar -->
    <div class="mt-16 grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-3xl mx-auto">
      {[
        { icon: Percent, label: 'Descuento máximo', value: '50%' },
        { icon: Flame, label: 'Ofertas activas', value: '1,240' },
        { icon: Clock, label: 'Actualización', value: 'C/6hs' },
        { icon: ArrowRight, label: 'Categorías', value: '12+' },
      ].map((stat) => (
        <div class="p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm">
          <stat.icon class="w-5 h-5 text-ml-yellow mx-auto mb-2" />
          <div class="text-xl font-bold text-white">{stat.value}</div>
          <div class="text-xs text-gray-400">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>